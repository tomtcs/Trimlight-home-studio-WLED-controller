[Unit]
Description=Trimlight Studio WLED API and calendar scheduler
After=network.target

[Service]
Type=simple
User=trimlight-studio
Group=trimlight-studio
WorkingDirectory=/opt/trimlight-studio/current
Environment=STUDIO_DB=/var/lib/trimlight-studio/studio.sqlite3
Environment=STUDIO_BIND=127.0.0.1
Environment=PORT=8000
ExecStart=/usr/bin/python3 -B -u /opt/trimlight-studio/current/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=multi-user.target
